{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadMetadata",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "ssm:DescribeInstanceInformation",
        "ssm:DescribeParameters",
        "ssm:DescribeDocument",
        "ssm:GetCommandInvocation",
        "ssm:ListCommandInvocations",
        "ssm:ListCommands"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LaunchOnlyTaggedT4gSmall",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:<REGION>:<ACCOUNT_ID>:instance/*",
      "Condition": {
        "StringEquals": { "aws:RequestTag/Project": "KeelCRM", "ec2:InstanceType": "t4g.small" }
      }
    },
    {
      "Sid": "LaunchOnlyTaggedVolumes",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:<REGION>:<ACCOUNT_ID>:volume/*",
      "Condition": { "StringEquals": { "aws:RequestTag/Project": "KeelCRM" } }
    },
    {
      "Sid": "LaunchSupportingResources",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:<REGION>::image/*",
        "arn:aws:ec2:<REGION>:<ACCOUNT_ID>:subnet/*",
        "arn:aws:ec2:<REGION>:<ACCOUNT_ID>:network-interface/*"
      ]
    },
    {
      "Sid": "LaunchWithKeelSecurityGroupOnly",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:<REGION>:<ACCOUNT_ID>:security-group/*",
      "Condition": { "StringEquals": { "aws:ResourceTag/Project": "KeelCRM" } }
    },
    {
      "Sid": "CreateTaggedKeelSecurityGroup",
      "Effect": "Allow",
      "Action": "ec2:CreateSecurityGroup",
      "Resource": "arn:aws:ec2:<REGION>:<ACCOUNT_ID>:security-group/*",
      "Condition": { "StringEquals": { "aws:RequestTag/Project": "KeelCRM" } }
    },
    {
      "Sid": "CreateSecurityGroupInVpc",
      "Effect": "Allow",
      "Action": "ec2:CreateSecurityGroup",
      "Resource": "arn:aws:ec2:<REGION>:<ACCOUNT_ID>:vpc/*"
    },
    {
      "Sid": "TagOnlyWhileCreating",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "*",
      "Condition": { "StringEquals": { "ec2:CreateAction": ["RunInstances", "CreateSecurityGroup"] } }
    },
    {
      "Sid": "ManageKeelSecurityGroupRulesOnly",
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress"
      ],
      "Resource": "arn:aws:ec2:<REGION>:<ACCOUNT_ID>:security-group/*",
      "Condition": { "StringEquals": { "aws:ResourceTag/Project": "KeelCRM" } }
    },
    {
      "Sid": "OperateKeelInstanceOnlyNoTerminate",
      "Effect": "Allow",
      "Action": ["ec2:StartInstances", "ec2:StopInstances", "ec2:RebootInstances"],
      "Resource": "arn:aws:ec2:<REGION>:<ACCOUNT_ID>:instance/*",
      "Condition": { "StringEquals": { "aws:ResourceTag/Project": "KeelCRM" } }
    },
    {
      "Sid": "PassOnlyTheKeelInstanceRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/KeelCrmEc2Role",
      "Condition": { "StringEquals": { "iam:PassedToService": "ec2.amazonaws.com" } }
    },
    {
      "Sid": "CommandsOnKeelInstanceOnly",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ec2:<REGION>:<ACCOUNT_ID>:instance/*",
      "Condition": { "StringEquals": { "ssm:resourceTag/Project": "KeelCRM" } }
    },
    {
      "Sid": "CommandDocuments",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ssm:<REGION>::document/AWS-RunShellScript",
        "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:document/KeelCrm-Update"
      ]
    },
    {
      "Sid": "ManageTheKeelUpdateDocument",
      "Effect": "Allow",
      "Action": ["ssm:CreateDocument", "ssm:UpdateDocument", "ssm:UpdateDocumentDefaultVersion", "ssm:AddTagsToResource"],
      "Resource": "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:document/KeelCrm-Update"
    },
    {
      "Sid": "WriteNonSecretSettingsOnly",
      "Effect": "Allow",
      "Action": "ssm:PutParameter",
      "Resource": [
        "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/keel/production/SITE_HOST",
        "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/keel/production/SECURE_HSTS_SECONDS",
        "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/keel/production/LOG_LEVEL",
        "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/keel/production/DEFAULT_FROM_EMAIL",
        "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/keel/production/CADDY_GLOBAL_OPTIONS"
      ]
    },
    {
      "Sid": "NeverReadSecretValues",
      "Effect": "Deny",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath",
        "ssm:GetParameterHistory",
        "secretsmanager:GetSecretValue",
        "secretsmanager:BatchGetSecretValue"
      ],
      "Resource": "*"
    },
    {
      "Sid": "OnlyTheKeelRegion",
      "Effect": "Deny",
      "NotAction": ["iam:*", "sts:*"],
      "Resource": "*",
      "Condition": { "StringNotEquals": { "aws:RequestedRegion": "<REGION>" } }
    }
  ]
}
