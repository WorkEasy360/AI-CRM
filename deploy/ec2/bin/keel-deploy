#!/bin/bash
# Deploy or restart Keel CRM on this host.
#
#   keel-deploy <image-tag>   pull that image tag, migrate (schema owner), start everything, health-check
#   keel-deploy --restart     re-render config (the public IP may have changed) and start the current tag
#
# Configuration lives in SSM Parameter Store under /keel/production/. Secrets that do not exist yet are
# generated here, on the host, and stored as SecureString with --no-overwrite: they never pass through
# a workstation, CI or a chat, and a rebuilt host can recover them. Nothing in this script prints a
# secret value.
set -euo pipefail
umask 077

ETC=/etc/keel
STATE=/var/lib/keel
SRC=/opt/keel/src/deploy/ec2
PREFIX=/keel/production
IMAGE_REPO="${KEEL_IMAGE_REPO:-ghcr.io/workeasy360/ai-crm}"

log() { printf '%s keel-deploy: %s\n' "$(date -u +%FT%TZ)" "$*"; }
die() { log "ERROR: $*"; exit 1; }

imds() {
  local token
  token="$(curl -fsS -X PUT http://169.254.169.254/latest/api/token -H 'X-aws-ec2-metadata-token-ttl-seconds: 60')"
  curl -fsS -H "X-aws-ec2-metadata-token: $token" "http://169.254.169.254/latest/meta-data/$1"
}

[ "$(id -u)" -eq 0 ] || die "run as root"
exec 9>/run/keel-deploy.lock
flock -n 9 || die "another deploy is running"

mode=deploy
if [ "${1:-}" = "--restart" ]; then
  mode=restart
  TAG="$(cat "$STATE/current" 2>/dev/null)" || die "no current release recorded; run keel-deploy <tag> first"
else
  TAG="${1:?usage: keel-deploy <image-tag> | --restart}"
fi
[[ "$TAG" =~ ^[A-Za-z0-9._-]{1,128}$ ]] || die "invalid image tag"

REGION="$(imds placement/region)"
export AWS_DEFAULT_REGION="$REGION"
install -d -m 0755 "$ETC" "$STATE"
install -d -m 0700 /run/keel

# --- secrets ------------------------------------------------------------------------------------------
put_secret() { # name, value on stdin; written through a 0600 tmpfs file so it is never an argument
  local tmp; tmp="$(mktemp /run/keel/param.XXXXXX)"
  cat >"$tmp"
  aws ssm put-parameter --name "$PREFIX/$1" --type SecureString --value "file://$tmp" --no-overwrite >/dev/null \
    || { rm -f "$tmp"; return 1; }
  rm -f "$tmp"
}
ensure_secret() { # name, generator (python expression)
  if ! aws ssm describe-parameters --parameter-filters "Key=Name,Values=$PREFIX/$1" \
      --query 'length(Parameters)' --output text | grep -qx 1; then
    log "generating $1"
    python3 -c "import base64,os,secrets; print($2, end='')" | put_secret "$1"
  fi
}
ensure_secret SECRET_KEY 'secrets.token_urlsafe(64)'
ensure_secret MESSAGING_ENCRYPTION_KEYS 'base64.urlsafe_b64encode(os.urandom(32)).decode()'
ensure_secret POSTGRES_PASSWORD 'secrets.token_hex(32)'
ensure_secret CRM_MIGRATOR_PASSWORD 'secrets.token_hex(32)'
ensure_secret CRM_APP_PASSWORD 'secrets.token_hex(32)'
ensure_secret REDIS_PASSWORD 'secrets.token_hex(32)'

# --- render host configuration -----------------------------------------------------------------------
PARAMS_JSON="$(mktemp /run/keel/params.XXXXXX)"
aws ssm get-parameters-by-path --path "$PREFIX" --recursive --with-decryption \
  --query 'Parameters[].{n:Name,v:Value}' --output json >"$PARAMS_JSON"
PUBLIC_IP="$(imds public-ipv4)" || die "instance has no public IPv4"
KEEL_ETC="$ETC" PUBLIC_IP="$PUBLIC_IP" PREFIX="$PREFIX" python3 - "$PARAMS_JSON" <<'PY'
import json, os, sys

etc, prefix = os.environ["KEEL_ETC"], os.environ["PREFIX"] + "/"
p = {i["n"][len(prefix):]: i["v"] for i in json.load(open(sys.argv[1]))}
for k, v in p.items():
    if "\n" in v or "\r" in v:
        sys.exit(f"parameter {k} contains a newline")

# Default hostname: sslip.io maps <a-b-c-d>.sslip.io to the IP, so HTTPS works without a domain.
host = p.get("SITE_HOST") or os.environ["PUBLIC_IP"].replace(".", "-") + ".sslip.io"

def write(path, lines, uid=0, gid=0, mode=0o600):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    with os.fdopen(fd, "w") as f:
        f.write("\n".join(lines) + "\n")
    os.chown(tmp, uid, gid)
    os.chmod(tmp, mode)
    os.replace(tmp, path)

app = [
    "ENVIRONMENT=production",
    f"SECRET_KEY={p['SECRET_KEY']}",
    f"MESSAGING_ENCRYPTION_KEYS={p['MESSAGING_ENCRYPTION_KEYS']}",
    f"DATABASE_URL=postgres://crm_app:{p['CRM_APP_PASSWORD']}@postgres:5432/keel",
    f"REDIS_URL=redis://:{p['REDIS_PASSWORD']}@redis:6379/0",
    f"CELERY_BROKER_URL=redis://:{p['REDIS_PASSWORD']}@redis:6379/1",
    f"ALLOWED_HOSTS={host}",
    f"CSRF_TRUSTED_ORIGINS=https://{host}",
    f"FRONTEND_ORIGIN=https://{host}",
]
# Optional settings: absent means "feature not configured", never a weaker default.
for key in ("EMAIL_URL", "DEFAULT_FROM_EMAIL", "ANTHROPIC_API_KEY", "SECURE_HSTS_SECONDS", "LOG_LEVEL"):
    if p.get(key):
        app.append(f"{key}={p[key]}")
write(f"{etc}/keel.env", app)
write(f"{etc}/migrate.env",
      [f"MIGRATOR_DATABASE_URL=postgres://crm_migrator:{p['CRM_MIGRATOR_PASSWORD']}@postgres:5432/keel"])
write(f"{etc}/caddy.env", [
    f"SITE_HOST={host}",
    # Same ramp as Django's SECURE_HSTS_SECONDS (config/settings/prod.py default 300).
    f"HSTS_SECONDS={int(p.get('SECURE_HSTS_SECONDS') or 300)}",
    f"KEEL_CADDY_GLOBAL_OPTIONS={p.get('CADDY_GLOBAL_OPTIONS', '')}",
])
# Files read inside the postgres (uid 999) and redis (uid 999, gid 1000) containers.
for name in ("POSTGRES_PASSWORD", "CRM_MIGRATOR_PASSWORD", "CRM_APP_PASSWORD"):
    write(f"{etc}/secrets/{name.lower()}", [p[name]], uid=999, gid=999, mode=0o400)
write(f"{etc}/redis/redis.conf", [
    "bind * -::*",
    f"requirepass {p['REDIS_PASSWORD']}",
    # Broker durability across restarts; cache keys all carry TTLs, so never evict broker messages.
    "appendonly yes",
    "appendfsync everysec",
    'save ""',
    "maxmemory 96mb",
    "maxmemory-policy noeviction",
], uid=999, gid=1000, mode=0o400)
print(host)
PY
rm -f "$PARAMS_JSON"
SITE_HOST="$(sed -n 's/^SITE_HOST=//p' "$ETC/caddy.env")"
chmod 0755 "$ETC/secrets" "$ETC/redis"

# --- PostgreSQL TLS (host-local CA; the app verifies the "postgres" name with verify-full) -----------
if [ ! -s "$ETC/pg-tls/server.crt" ]; then
  log "creating PostgreSQL TLS material"
  install -d -m 0755 "$ETC/pg-tls"
  work="$(mktemp -d /run/keel/tls.XXXXXX)"
  openssl req -x509 -newkey rsa:3072 -nodes -days 3650 -subj "/CN=keel-postgres-ca" \
    -keyout "$work/ca.key" -out "$ETC/pg-tls/ca.crt" 2>/dev/null
  openssl req -newkey rsa:3072 -nodes -subj "/CN=postgres" -keyout "$work/server.key" -out "$work/server.csr" 2>/dev/null
  printf 'subjectAltName=DNS:postgres\nextendedKeyUsage=serverAuth\n' >"$work/ext"
  openssl x509 -req -in "$work/server.csr" -CA "$ETC/pg-tls/ca.crt" -CAkey "$work/ca.key" \
    -CAserial "$work/ca.srl" -CAcreateserial \
    -days 3650 -extfile "$work/ext" -out "$ETC/pg-tls/server.crt" 2>/dev/null
  install -m 0600 -o 999 -g 999 "$work/server.key" "$ETC/pg-tls/server.key"
  chmod 0644 "$ETC/pg-tls/ca.crt" "$ETC/pg-tls/server.crt"
  rm -rf "$work" # the CA key is not kept: regenerate all three files to rotate
fi

# --- start --------------------------------------------------------------------------------------------
export KEEL_API_IMAGE="$IMAGE_REPO-api:$TAG" KEEL_WEB_IMAGE="$IMAGE_REPO-web:$TAG"
cd "$SRC"
if [ "$mode" = deploy ]; then
  log "pulling $TAG"
  docker compose --profile migrate pull --quiet
fi
docker compose up -d --wait postgres redis
if [ "$mode" = deploy ]; then
  log "migrating (schema owner), granting runtime role, checking RLS"
  docker compose --profile migrate run --rm migrate
fi
docker compose up -d --wait --remove-orphans api worker-critical worker-heavy beat web caddy

if [ "$mode" = deploy ]; then
  prev="$(cat "$STATE/current" 2>/dev/null || true)"
  [ -n "$prev" ] && [ "$prev" != "$TAG" ] && echo "$prev" >"$STATE/previous"
  echo "$TAG" >"$STATE/current"
fi

# Certificate issuance can take a minute on first start; the check goes through Caddy with real TLS.
for _ in $(seq 1 36); do
  if curl -fsS -o /dev/null --resolve "$SITE_HOST:443:127.0.0.1" "https://$SITE_HOST/health/live/"; then
    log "healthy: https://$SITE_HOST ($TAG)"
    exit 0
  fi
  sleep 5
done
die "https://$SITE_HOST/health/live/ did not answer over valid TLS; see: docker compose logs caddy api"
