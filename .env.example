# Copy to .env for local development. Never commit .env.
ENVIRONMENT=development
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=dev-only-insecure-secret-key-do-not-use-in-production
DATABASE_URL=postgres://crm_app:crm_app_dev_password@localhost:5433/keel
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
EMAIL_URL=smtp://localhost:1025
DEFAULT_FROM_EMAIL=no-reply@keel.local
FRONTEND_ORIGIN=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
# Where CSV import uploads and export files are kept (never served directly). Defaults to backend/private.
# PRIVATE_STORAGE_ROOT=/var/lib/keel/private

# ---- Scaling / production runtime (defaults shown; see docs/architecture/scaling.md) ----
# PRIVATE_STORAGE_BACKEND=filesystem      # s3 in any multi-instance deployment
# PRIVATE_STORAGE_BUCKET=                 # required with s3
# AWS_REGION=ap-south-1
# DB_POOL=false                           # true in production: psycopg pool capped at DB_POOL_MAX_SIZE per process
# DB_POOL_MAX_SIZE=4                      # defaults to GUNICORN_THREADS
# DB_STATEMENT_TIMEOUT_MS=15000
# GUNICORN_WORKERS=2
# GUNICORN_THREADS=4
# CACHE_FAIL_OPEN=false                   # true in production: Redis outage degrades to the database
# TRUSTED_PROXY_COUNT=0                   # 2 behind CloudFront + ALB, 1 behind a single proxy
# EMAIL_ASYNC=true                        # deliver email from the notifications queue
# METRICS_BACKEND=log                     # cloudwatch in production
# DASHBOARD_CACHE_SECONDS=60
# MAX_ACTIVE_JOBS_PER_ORG=3

# ---- Communication: email (OAuth) and WhatsApp (Cloud API). Empty = feature shows "not configured". ----
# MESSAGING_PROVIDER_BACKEND=live         # fake for local development without provider accounts
# MESSAGING_ENCRYPTION_KEYS=              # required in production: comma-separated Fernet keys (first encrypts)
#                                         # generate one: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# EMAIL_OAUTH_GOOGLE_CLIENT_ID=
# EMAIL_OAUTH_GOOGLE_CLIENT_SECRET=
# EMAIL_OAUTH_MICROSOFT_CLIENT_ID=
# EMAIL_OAUTH_MICROSOFT_CLIENT_SECRET=
# EMAIL_OAUTH_MICROSOFT_TENANT=common

# ---- Integration Hub (Settings > Integrations). Secrets use MESSAGING_ENCRYPTION_KEYS; rotate with manage.py reencrypt_secrets. ----
# INTEGRATIONS_ALLOW_HTTP=false           # local development only: allow http:// integration and webhook destinations
# INTEGRATIONS_ALLOWED_PORTS=             # default 443,8443 (https)
# INTEGRATIONS_MAX_DELIVERY_ATTEMPTS=8
# INTEGRATIONS_SYNC_BATCH_SIZE=100
# INTEGRATIONS_INBOUND_PER_MINUTE=600     # per connection
# INTEGRATIONS_API_KEY_MAX_DAYS=365
# PLAN_USER_LIMITS={"free": 5, "business": 250}   # seats per plan; organization.settings.max_users overrides
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_APP_SECRET=                    # Meta app secret: verifies X-Hub-Signature-256 on the webhook
# WHATSAPP_VERIFY_TOKEN=                  # the verify token you enter in Meta's webhook configuration

# ---- AI (drafts and summaries only; a person reviews everything) ----
# AI_PROVIDER_BACKEND=anthropic           # fake for local development / tests
# ANTHROPIC_API_KEY=
# AI_MODEL_FAST=claude-haiku-4-5          # drafting, follow-ups, email rewrites
# AI_MODEL_STRONG=claude-opus-5           # deal summaries (multi-signal reasoning)
# AI_USER_REQUESTS_PER_HOUR=60
# AI_ORG_TOKENS_PER_DAY=2000000
