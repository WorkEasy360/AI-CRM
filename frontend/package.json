    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.25",
    "jsdom": "27.4.0",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.28",
