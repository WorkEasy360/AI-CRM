    "components": {
        "schemas": {
            "ActorTypeEnum": {
                "enum": [
                    "user",
                    "system",
                    "ai",
                    "integration"
                ],
                "type": "string",
                "description": "* `user` - User\n* `system` - System\n* `ai` - AI\n* `integration` - Integration"
            },
            "AuditEvent": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid",
                        "readOnly": true
                    },
                    "action": {
                        "type": "string",
                        "readOnly": true
                    },
                    "actor_type": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/ActorTypeEnum"
                            }
                        ],
                        "readOnly": true
                    },
                    "actor_user_id": {
                        "type": "string",
                        "format": "uuid",
                        "readOnly": true
                    },
                    "actor_email": {
                        "type": "string",
                        "nullable": true,
                        "readOnly": true
                    },
                    "resource_type": {
                        "type": "string",
                        "readOnly": true
                    },
                    "resource_id": {
                        "type": "string",
                        "readOnly": true
                    },
                    "ip": {
                        "type": "string",
                        "readOnly": true,
                        "nullable": true
                    },
                    "request_id": {
                        "type": "string",
                        "readOnly": true
                    },
                    "metadata": {
                        "readOnly": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    }
                },
                "required": [
                    "action",
                    "actor_email",
                    "actor_type",
                    "actor_user_id",
                    "created_at",
                    "id",
                    "ip",
                    "metadata",
                    "request_id",
                    "resource_id",
                    "resource_type"
                ]
            },
            "Invitation": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid",
                        "readOnly": true
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "readOnly": true
                    },
                    "role": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/RoleRef"
                            }
                        ],
                        "readOnly": true
                    },
                    "status": {
                        "type": "string",
                        "readOnly": true
                    },
                    "expires_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "invited_by": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/UserPublic"
                            }
                        ],
                        "readOnly": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    }
                },
                "required": [
                    "created_at",
                    "email",
                    "expires_at",
                    "id",
                    "invited_by",
                    "role",
                    "status"
                ]
            },
            "Membership": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid",
                        "readOnly": true
                    },
                    "user": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/UserPublic"
                            }
                        ],
                        "readOnly": true
                    },
                    "role": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/RoleRef"
                            }
                        ],
                        "readOnly": true
                    },
                    "status": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/StatusEnum"
                            }
                        ],
                        "readOnly": true
                    },
                    "joined_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "last_active_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true,
                        "nullable": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    }
                },
                "required": [
                    "created_at",
                    "id",
                    "joined_at",
                    "last_active_at",
                    "role",
                    "status",
                    "user"
                ]
            },
            "PaginatedAuditEventList": {
                "type": "object",
                "required": [
                    "results"
                ],
                "properties": {
                    "next": {
                        "type": "string",
                        "nullable": true,
                        "format": "uri",
                        "example": "http://api.example.org/accounts/?cursor=cD00ODY%3D\""
                    },
                    "previous": {
                        "type": "string",
                        "nullable": true,
                        "format": "uri",
                        "example": "http://api.example.org/accounts/?cursor=cj0xJnA9NDg3"
                    },
                    "results": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/AuditEvent"
                        }
                    }
                }
            },
            "PaginatedInvitationList": {
                "type": "object",
                "required": [
                    "results"
                ],
                "properties": {
                    "next": {
                        "type": "string",
                        "nullable": true,
                        "format": "uri",
                        "example": "http://api.example.org/accounts/?cursor=cD00ODY%3D\""
                    },
                    "previous": {
                        "type": "string",
                        "nullable": true,
                        "format": "uri",
                        "example": "http://api.example.org/accounts/?cursor=cj0xJnA9NDg3"
                    },
                    "results": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Invitation"
                        }
                    }
                }
            },
            "PaginatedMembershipList": {
                "type": "object",
                "required": [
                    "results"
                ],
                "properties": {
                    "next": {
                        "type": "string",
